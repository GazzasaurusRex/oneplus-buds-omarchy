{
  "schemaVersion": 1,
  "id": "oneplus-buds.control",
  "name": "OnePlus Buds Control",
  "version": "0.0.1",
  "author": "Gaz",
  "description": "Linux monitoring and verified ANC control for compatible OnePlus earbuds.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "OnePlus Buds",
    "description": "Connection, battery, and verified controls for compatible OnePlus earbuds.",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right"
  },
  "license": "MIT",
  "repository": "https://github.com/GazzasaurusRex/oneplus-buds-omarchy",
  "homepage": "https://github.com/GazzasaurusRex/oneplus-buds-omarchy"
}
